local GAME_STATE = {
	MENU = "menu",
	PLAYING = "playing",
	GAME_OVER = "game_over",
	WIN = "win"
}

function init(self)
	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	
	self.state = GAME_STATE.MENU
	self.score = 0
	self.lives = 3
	
	self.ball_url = "ball" 
	self.paddle_url = "paddle"
	
	-- 初始显示
	msg.post("#game_gui", "show_message", {text = "PRESS SPACE TO START"})
	msg.post("#game_gui", "update_score", {score = 0})
	msg.post("#game_gui", "update_lives", {lives = 3})
end

function start_game(self)
	print("Starting game...")
	
	-- 清理旧砖块
	if self.brick_ids then
		for _, id in ipairs(self.brick_ids) do
			pcall(go.delete, id)
		end
	end
	self.brick_ids = {}

	self.score = 0
	self.lives = 3
	self.state = GAME_STATE.PLAYING
	
	msg.post("#game_gui", "hide_message")
	msg.post("#game_gui", "update_score", {score = self.score})
	msg.post("#game_gui", "update_lives", {lives = self.lives})
	
	create_bricks(self)
	msg.post(self.ball_url, "reset")
	msg.post(self.paddle_url, "reset")
end

function create_bricks(self)
	self.brick_ids = {}
	local rows = 5
	local cols = 8
	local brick_width = 100
	local brick_height = 30
	local padding = 10
	local start_x = 80
	local start_y = 550
	
	local color_names = {"red", "orange", "yellow", "green", "blue"}
	
	for row = 1, rows do
		for col = 1, cols do
			local pos = vmath.vector3(
				start_x + (col - 1) * (brick_width + padding),
				start_y - (row - 1) * (brick_height + padding),
				0.1
			)
			local brick_id = factory.create("#brick_factory", pos)
			msg.post(brick_id, "set_color", {color = color_names[row]})
			table.insert(self.brick_ids, brick_id)
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("brick_destroyed") then
		self.score = self.score + 10
		msg.post("#game_gui", "update_score", {score = self.score})
		
		if self.score >= (5 * 8 * 10) then
			self.state = GAME_STATE.WIN
			msg.post("#game_gui", "show_message", {text = "YOU WIN! PRESS SPACE TO RESTART"})
			msg.post(self.ball_url, "stop")
		end
	elseif message_id == hash("ball_lost") then
		self.lives = self.lives - 1
		msg.post("#game_gui", "update_lives", {lives = self.lives})
		
		if self.lives <= 0 then
			self.state = GAME_STATE.GAME_OVER
			msg.post("#game_gui", "show_message", {text = "GAME OVER! PRESS SPACE TO RESTART"})
			msg.post(self.ball_url, "stop")
		else
			msg.post(self.ball_url, "reset")
		end
	end
end

function on_input(self, action_id, action)
	if action_id == hash("space") and action.pressed then
		if self.state ~= GAME_STATE.PLAYING then
			start_game(self)
		end
	end
end
