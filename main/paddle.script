local speed = 600
local screen_width = 960
local paddle_width = 120

function init(self)
	self.position = go.get_position()
	msg.post(".", "acquire_input_focus")
	print("Paddle initialized at: " .. tostring(self.position))
end

function update(self, dt)
	if self.target_x then
		local half_width = paddle_width / 2
		local tx = math.max(half_width, math.min(screen_width - half_width, self.target_x))
		
		-- 平滑移动
		self.position.x = self.position.x + (tx - self.position.x) * 0.2
		go.set_position(self.position)
	end
end

function on_input(self, action_id, action)
	-- 无论是否有 action_id，只要有 x 坐标就更新目标位置
	if action.x then
		self.target_x = action.x
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("reset") then
		self.position.x = screen_width / 2
		self.target_x = self.position.x
		go.set_position(self.position)
	end
end
