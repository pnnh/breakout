local speed = 600
local screen_width = 960
local paddle_width = 120

function init(self)
	self.position = go.get_position()
	msg.post(".", "acquire_input_focus")
	self.input_x = 0
end

function update(self, dt)
	if self.input_x ~= 0 then
		local half_width = paddle_width / 2
		self.position.x = self.position.x + self.input_x * speed * dt
		self.position.x = math.max(half_width, math.min(screen_width - half_width, self.position.x))
		go.set_position(self.position)
	end
	-- 每一帧重置，等待下一次输入
	self.input_x = 0
end

function on_input(self, action_id, action)
	if action_id == hash("left") then
		self.input_x = -1
	elseif action_id == hash("right") then
		self.input_x = 1
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("reset") then
		self.position.x = screen_width / 2
		self.input_x = 0
		go.set_position(self.position)
	end
end
